<?xml version="1.0" encoding="utf-8"?>
<!-- Глобальный поиск Android TV: результаты отдаёт search/SearchProvider,
     выбранный приходит в MainActivity интентом GLOBALSEARCH -->
<searchable xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:hint="@string/global_search_hint"
    android:includeInGlobalSearch="true"
    android:queryAfterZeroResults="true"
    android:searchSettingsDescription="@string/global_search_settings"
    android:searchSuggestAuthority="my.torrstream.app.atvsearch"
    android:searchSuggestIntentAction="GLOBALSEARCH"
    android:searchSuggestIntentData="content://my.torrstream.app.atvsearch/video"
    android:searchSuggestSelection=" ?"
    android:searchSuggestThreshold="2" />
