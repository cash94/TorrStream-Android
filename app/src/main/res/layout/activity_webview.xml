<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome"
    tools:context=".MainActivity">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|bottom"
        android:layout_margin="6dp"
        android:alpha="0.5"
        android:contentDescription="@string/show_menu"
        android:scaleType="center"
        android:visibility="gone"
        app:fabCustomSize="32dp"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        app:maxImageSize="30dp"
        app:srcCompat="@drawable/lampa_logo_round"
        app:tint="@null"
        tools:visibility="visible" />

    <!-- WebView — под экраном загрузки. Пока страница грузится, он скрыт (invisible):
         видимый с самого старта, он задерживал первый кадр окна на секунды. Когда
         страница готова, его открывают под загрузчиком и убирают загрузчик только после
         того, как WebView нарисовал кадр (MainActivity.dismissLoader). Раньше WebView лежал
         сверху и показывался одновременно с уходом загрузчика — первый кадр ещё ни разу
         не рисовавшегося WebView выходил чёрным. -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/welcome"
        android:visibility="invisible" />

    <!-- Экран загрузки. Занимает всё окно и несёт собственный градиент, поэтому перекрывает
         WebView под собой, пока страница не готова (MainActivity.dismissLoader). -->
    <FrameLayout
        android:id="@+id/loaderView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/loader_backdrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Знак приложения «дышит» (anim/loader_breathe), вокруг него вращается
                 орбита, под ним — мягкое свечение в цветах значка. -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/loader_glow">

                <ProgressBar
                    android:layout_width="196dp"
                    android:layout_height="196dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateDrawable="@drawable/loader_ring"
                    android:indeterminateDuration="1600" />

                <ImageView
                    android:id="@+id/loaderMark"
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/loader_mark" />
            </FrameLayout>

            <my.torrstream.app.ShimmerTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="38sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>