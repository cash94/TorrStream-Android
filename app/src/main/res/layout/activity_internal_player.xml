<?xml version="1.0" encoding="utf-8"?>
<!-- clickable, so a tap anywhere the controls don't cover reaches the activity and toggles the
     HUD (PlayerView itself does not consume touches with use_controller off). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clickable="true"
    android:focusable="false"
    android:keepScreenOn="true">

    <!-- use_controller is off: the panel below is our own, so D-pad focus order can be
         controlled exactly (buttons -> seek bar -> hidden). -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fill"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/playerProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Шапка HUD в стиле веб-плеера: затемняющая полоса во всю ширину, крупный заголовок и
         под ним статистика TorrServer подписанными парами («TORRSERVER 1.2 GB | СКОРОСТЬ …»).
         Нижний отступ большой, чтобы затемнение сходило на нет ниже текста, а не обрывалось
         под ним. Справа — место под часы. Показывается и прячется вместе с панелью. -->
    <LinearLayout
        android:id="@+id/playerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/player_top_scrim"
        android:orientation="vertical"
        android:paddingStart="@dimen/hud_header_start"
        android:paddingTop="@dimen/hud_header_top"
        android:paddingEnd="110dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/playerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="2"
            android:shadowRadius="10"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hud_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/playerStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hud_stats_text"
            android:visibility="gone"
            tools:ignore="HardcodedText"
            tools:text="TORRSERVER 1.2 GB  |  СКОРОСТЬ 24.6 Mb/s  |  ПИРЫ 12 / 48  |  СИДЫ 7"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Часы в правом углу шапки. Объявлены после неё, чтобы затемнение шапки не ложилось
         поверх. Видны и при скрытом HUD, но тогда приглушены (alpha из кода), чтобы не тянуть
         на себя взгляд; с HUD — ярче, как в веб-плеере. -->
    <TextView
        android:id="@+id/playerClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/hud_clock_top"
        android:layout_marginEnd="@dimen/hud_clock_end"
        android:alpha="0.55"
        android:fontFeatureSettings="tnum"
        android:shadowColor="#99000000"
        android:shadowDy="2"
        android:shadowRadius="10"
        android:textColor="@android:color/white"
        android:textSize="@dimen/hud_clock_text"
        android:textStyle="bold"
        tools:ignore="HardcodedText"
        tools:text="23:47" />

    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/player_panel_bg"
        android:orientation="vertical"
        android:paddingStart="@dimen/hud_side_pad"
        android:paddingTop="48dp"
        android:paddingEnd="@dimen/hud_side_pad"
        android:paddingBottom="@dimen/hud_bottom_pad">

        <!-- Строка буфера, как в веб-плеере: «БУФЕР 25 сек | ДО КОНЦА 46 мин | КОНЕЦ В 14:04»,
             у левого края над временем. Запас буфера окрашен по уровню (см. updateStatusLine). -->
        <TextView
            android:id="@+id/remainingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hud_focus_ring"
            android:layout_marginBottom="8dp"
            android:ellipsize="end"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textColor="@android:color/white"
            android:textSize="@dimen/hud_buffer_text"
            tools:ignore="HardcodedText"
            tools:text="БУФЕР 25 сек  |  ДО КОНЦА 46 мин 49 сек  |  КОНЕЦ В 14:04" />

        <!-- Время, полоса перемотки, длительность — одна строка, как #time-display веб-плеера.
             Полоса и её фокус (кольцо цвета фокуса) — из кода, HudStyle. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hud_focus_ring"
            android:layout_marginEnd="@dimen/hud_focus_ring"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/positionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/hud_time_text" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hud_seek_margin"
                android:layout_marginEnd="@dimen/hud_seek_margin"
                android:layout_weight="1"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:max="1000"
                android:maxHeight="10dp"
                android:minHeight="10dp"
                android:nextFocusDown="@+id/btnPlayPause"
                android:paddingStart="7dp"
                android:paddingTop="8dp"
                android:paddingEnd="7dp"
                android:paddingBottom="8dp"
                android:splitTrack="false" />

            <TextView
                android:id="@+id/durationText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:fontFeatureSettings="tnum"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="@dimen/hud_time_text" />
        </LinearLayout>

        <!-- Три колонки, как .button-row веб-плеера: пустая слева той же ширины, что и правая, —
             поэтому воспроизведение стоит ровно по центру экрана, сколько бы кнопок ни было
             справа. Порядок кнопок = порядок обхода стрелками. Серии и кнопки соседних серий
             видны только у сериала (updateEpisodeButtons). -->
        <LinearLayout
            android:id="@+id/buttonsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hud_buttons_top"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevEpisode"
                    style="@style/PlayerControlButton"
                    android:layout_marginStart="0dp"
                    android:contentDescription="@string/player_prev_episode"
                    android:src="@drawable/ic_hud_prev" />

                <ImageButton
                    android:id="@+id/btnRewind"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_rewind"
                    android:src="@drawable/ic_hud_rewind" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    style="@style/PlayerControlButton"
                    android:layout_width="@dimen/hud_play"
                    android:layout_height="@dimen/hud_play"
                    android:layout_marginStart="@dimen/hud_play_gap"
                    android:contentDescription="@string/player_play_pause"
                    android:padding="@dimen/hud_play_pad"
                    android:src="@drawable/ic_hud_pause" />

                <ImageButton
                    android:id="@+id/btnForward"
                    style="@style/PlayerControlButton"
                    android:layout_marginStart="@dimen/hud_play_gap"
                    android:contentDescription="@string/player_forward"
                    android:src="@drawable/ic_hud_forward" />

                <ImageButton
                    android:id="@+id/btnNextEpisode"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_next_episode"
                    android:src="@drawable/ic_hud_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end|center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnEpisodes"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_episodes"
                    android:src="@drawable/ic_hud_episodes" />

                <ImageButton
                    android:id="@+id/btnTracks"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_tracks"
                    android:src="@drawable/ic_hud_tracks" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_settings"
                    android:src="@drawable/ic_hud_settings" />

                <ImageButton
                    android:id="@+id/btnResize"
                    style="@style/PlayerControlButton"
                    android:contentDescription="@string/player_resize"
                    android:nextFocusRight="@+id/btnResize"
                    android:src="@drawable/ic_hud_zoom" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- «← Назад для выхода» у нижнего края под кнопками, как #player-hint веб-плеера.
         Показывается и прячется вместе с ХУДом. -->
    <TextView
        android:id="@+id/playerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/hud_hint_bottom"
        android:shadowColor="#80000000"
        android:shadowRadius="4"
        android:text="@string/player_exit_hint"
        android:textColor="#CCAAAAAA"
        android:textSize="@dimen/hud_hint_text" />

    <!-- Первое «Назад» прячет ХУД и показывает это предупреждение, второе за две секунды —
         выход (dispatchKeyEvent), как в веб-плеере (control.js: playerBackPress). -->
    <TextView
        android:id="@+id/exitAlert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/hud_alert_bottom"
        android:background="@drawable/hud_alert_bg"
        android:maxLines="1"
        android:paddingStart="@dimen/hud_alert_pad_h"
        android:paddingTop="@dimen/hud_alert_pad_v"
        android:paddingEnd="@dimen/hud_alert_pad_h"
        android:paddingBottom="@dimen/hud_alert_pad_v"
        android:text="@string/player_exit_again"
        android:textColor="@android:color/white"
        android:textSize="@dimen/hud_alert_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Название режима масштаба после нажатия кнопки — как showToast веб-плеера -->
    <TextView
        android:id="@+id/scaleToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/hud_alert_bg"
        android:maxLines="1"
        android:paddingStart="@dimen/hud_alert_pad_h"
        android:paddingTop="@dimen/hud_alert_pad_v"
        android:paddingEnd="@dimen/hud_alert_pad_h"
        android:paddingBottom="@dimen/hud_alert_pad_v"
        android:textColor="@android:color/white"
        android:textSize="@dimen/hud_alert_text"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Seek read-out: where the scrub will land, which way it is going, and the current
         acceleration step. Centred, so it reads at a glance from across a room. -->
    <LinearLayout
        android:id="@+id/seekOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/seek_overlay_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="20dp"
        android:paddingEnd="32dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/seekOverlayTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="44sp"
            tools:ignore="HardcodedText"
            tools:text="01:23:45" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/seekOverlayDirection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#4A9EFF"
                android:textSize="18sp"
                tools:ignore="HardcodedText"
                tools:text="▶▶" />

            <TextView
                android:id="@+id/seekOverlayStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#B3FFFFFF"
                android:textSize="16sp"
                tools:ignore="HardcodedText"
                tools:text="30 сек" />
        </LinearLayout>
    </LinearLayout>

    <!-- Skip intro / credits, bottom-right. The hairline underneath drains over the ten seconds
         the offer stays up, so the deadline is visible without anything blinking or pulsing.
         Code lifts the whole block above the control bar whenever that is on screen. -->
    <LinearLayout
        android:id="@+id/skipContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="40dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/skipButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/skip_button_bg"
            android:focusable="true"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <View
            android:id="@+id/skipProgress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="2dp"
            android:background="#B34A9EFF" />
    </LinearLayout>

    <!-- Slide-out list for episodes / audio tracks / subtitles. Declared last so it sits above
         the control bar, and starts off-screen (translationX is applied in code once measured). -->
    <LinearLayout
        android:id="@+id/sidePanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#B30D0D12"
        android:orientation="vertical"
        android:visibility="invisible">

        <TextView
            android:id="@+id/sidePanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            android:textColor="#4A9EFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/sidePanelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingBottom="24dp"
            android:scrollbars="none" />
    </LinearLayout>

    <!-- Затемнение на длительной паузе: статичный кадр вредит матрице, особенно OLED.
         Не кликабельно и не фокусируемо, чтобы нажатия доходили до активити и будили плеер. -->
    <View
        android:id="@+id/dimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</FrameLayout>
