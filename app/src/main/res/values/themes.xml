<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LAMPA" parent="Theme.MaterialComponents">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/teal_200</item>
        <item name="colorPrimaryDark">@color/purple_500</item>
        <item name="colorAccent">@color/teal_500</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@drawable/welcome</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="alertDialogTheme">@style/AlertDialog</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>
    </style>
    <!-- Главный экран: окно до загрузки разметки показывает тот же градиент, что и экран
         загрузки, — без серой вспышки между иконкой в лаунчере и анимацией. -->
    <style name="Theme.LAMPA.Launch">
        <item name="android:windowBackground">@drawable/loader_backdrop</item>
    </style>
</resources>