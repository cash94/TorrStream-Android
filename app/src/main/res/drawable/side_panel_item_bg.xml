<?xml version="1.0" encoding="utf-8"?>
<!-- Row states for the slide-out panel. Focus has to be obvious from across a room, so it gets a
     solid accent fill; the currently playing item is marked more quietly, since it is not where
     the remote is pointing. ListView calls setChecked() on Checkable rows, so state_checked is
     the one that actually fires here (state_activated is kept for touch-only fallbacks). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A9EFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#553A7ACC" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A4A9EFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A4A9EFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
