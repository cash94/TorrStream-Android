<?xml version="1.0" encoding="utf-8"?>
<!-- Focus highlight for the on-screen player buttons. Same accent as the slide-out list rows, so
     focus looks the same wherever the remote is. It must not be a light fill: the icons are white
     and would disappear into it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4A9EFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#553A7ACC" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
