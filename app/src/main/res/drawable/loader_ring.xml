<?xml version="1.0" encoding="utf-8"?>
<!-- Вращающаяся орбита вокруг знака: развёртка от прозрачного через розовый к бирюзовому,
     из-за чего у кольца получается «хвост», а не сплошной обод. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromDegrees="0"
    android:pivotX="50%"
    android:pivotY="50%"
    android:toDegrees="360">
    <shape
        android:innerRadiusRatio="2.25"
        android:shape="ring"
        android:thicknessRatio="42"
        android:useLevel="false">
        <gradient
            android:centerColor="#99F654EC"
            android:endColor="#FF3CE8F6"
            android:startColor="#00F654EC"
            android:type="sweep" />
    </shape>
</rotate>
