<?xml version="1.0" encoding="utf-8"?>
<!-- CheckedTextView draws its checkMark on every row, so the tick has to be state-driven:
     only the checked row gets the icon, the rest get nothing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_player_check"
        android:state_checked="true" />
    <item android:drawable="@android:color/transparent" />
</selector>
